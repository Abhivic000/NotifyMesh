{
  "uid": "notification-delivery",
  "title": "Notification Delivery",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1, "title": "Notifications created (by channel)", "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum(rate(notifications_total[1m])) by (channel)", "legendFormat": "{{channel}}" }
      ]
    },
    {
      "id": 2, "title": "Sent vs permanently failed (by channel)", "type": "timeseries",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum(rate(notifications_sent_total[1m])) by (channel)", "legendFormat": "sent: {{channel}}" },
        { "refId": "B", "expr": "sum(rate(notifications_failed_total[1m])) by (channel)", "legendFormat": "failed: {{channel}}" }
      ]
    },
    {
      "id": 3, "title": "Retry rate (by channel / errorCode)", "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum(rate(retry_total[1m])) by (channel, errorCode)", "legendFormat": "{{channel}} / {{errorCode}}" }
      ]
    },
    {
      "id": 4, "title": "DLQ rate (by channel / errorCode)", "type": "timeseries",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum(rate(dlq_total[1m])) by (channel, errorCode)", "legendFormat": "{{channel}} / {{errorCode}}" }
      ]
    },
    {
      "id": 5, "title": "Provider success rate", "type": "timeseries",
      "gridPos": { "x": 0, "y": 16, "w": 24, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "max": 1, "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(notifications_sent_total[5m])) by (channel) / (sum(rate(provider_requests_total[5m])) by (channel) > 0)",
          "legendFormat": "{{channel}}"
        }
      ]
    }
  ]
}
