# Copy this file to .env and adjust as noted below.
# .env is gitignored — never commit real secrets.

# ── PostgreSQL ────────────────────────────────────────────────
# Safe to leave these placeholder values as-is for local dev.
POSTGRES_DB=notification_platform
POSTGRES_USER=notification_app
POSTGRES_PASSWORD=local_dev_only_change_me
DATABASE_URL=jdbc:postgresql://localhost:5432/notification_platform

# ── Redis ─────────────────────────────────────────────────────
# Safe as-is for local dev (no auth on local Redis).
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Kafka ─────────────────────────────────────────────────────
# Safe as-is. This is the HOST-facing listener (29092) — use this
# when running a Spring Boot service from IntelliJ on your machine.
# Containers talking to each other (e.g. kafka-ui) use kafka:9092 instead,
# which is already baked into docker-compose.yml, not something you set here.
KAFKA_BOOTSTRAP_SERVERS=localhost:29092

# ── JWT ───────────────────────────────────────────────────────
# YOU must generate a real value — do not ship the literal placeholder below.
# Generate one with (PowerShell):
#   [Convert]::ToBase64String((1..64 | ForEach-Object { Get-Random -Maximum 256 }))
# Needs to be a long, random, base64-safe string (HS256 wants 256+ bits).
JWT_SECRET=REPLACE_ME_WITH_A_GENERATED_SECRET

# ── Mock providers ────────────────────────────────────────────
# Safe as-is. Tune later to rehearse specific failure scenarios (Phase 6/9).
EMAIL_PROVIDER_FAILURE_RATE=0.1
SMS_PROVIDER_FAILURE_RATE=0.1
PUSH_PROVIDER_FAILURE_RATE=0.1

# ── Retry / rate limiting defaults ───────────────────────────
# Safe as-is — these are the PRD's suggested starting values (§32).
NOTIFICATION_RETRY_MAX_ATTEMPTS=5
NOTIFICATION_RETRY_INITIAL_DELAY=5s
NOTIFICATION_RETRY_MULTIPLIER=4
NOTIFICATION_RETRY_MAX_DELAY=10m
NOTIFICATION_RATE_LIMIT=100
